{
  "name": "heroui-solid",
  "version": "0.1.0",
  "description": "Unofficial SolidJS port of HeroUI v3, built on Kobalte and @heroui/styles",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "solid",
    "solidjs",
    "heroui",
    "kobalte",
    "components",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daveycodez/heroui-solid.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./overrides.css": "./dist/overrides.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify && tailwindcss -i src/styles/overrides.css -o dist/overrides.css --minify",
    "build": "bun run build:js && bun run build:css",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:publish": "publint && attw --pack . --profile esm-only --entrypoints ."
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.12",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@heroui/styles": "3.2.2",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/cli": "^4.3.2",
    "jsdom": "^26.1.0",
    "publint": "^0.3.21",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "tw-animate-css": "1.4.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^3.2.4"
  }
}
